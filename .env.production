# Production Environment Variables
# ===============================

# Database Configuration
DATABASE_URL=postgresql://postgres:your_secure_password@db:5432/ethical_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ethical_ai

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# API Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
API_HOST=0.0.0.0
API_PORT=8000

# Chicago Data Portal
CHICAGO_API_KEY=your_api_key_here
CHICAGO_API_BASE_URL=https://data.cityofchicago.org/resource

# Model Configuration
MODEL_PATH=/app/models/crime_predictor.pkl
MODEL_VERSION=2.4.1

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_FAIRNESS_CONSTRAINTS=true
ENABLE_SHAP_EXPLANATIONS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_REDIS_CACHE=true

# Security
JWT_SECRET=your_jwt_secret_here_change_this
CORS_ORIGINS=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
