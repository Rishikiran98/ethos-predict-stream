# Environment Variables for Ethical AI Policing Backend

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://your-lovable-app.lovable.app

# Chicago Data Portal
CHICAGO_API_KEY=your_api_key_here
CHICAGO_API_BASE_URL=https://data.cityofchicago.org/resource

# Model Configuration
MODEL_PATH=models/crime_predictor.pkl
MODEL_VERSION=2.4.1

# Dask Cluster (if using distributed processing)
DASK_SCHEDULER_ADDRESS=tcp://localhost:8786

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_FAIRNESS_CONSTRAINTS=true
ENABLE_SHAP_EXPLANATIONS=true
ENABLE_AUDIT_LOGGING=true
